# ============================================================================
# Prediction Market Backend — environment configuration
# Copy to `.env` and fill in. Every value here is read + validated at boot
# (see src/config/env.validation.ts). Missing/invalid required vars fail fast.
# ============================================================================

# ---- App ----
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed CORS origins (frontend URLs). Use * only in dev.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000
# Public base URL of this API (used in SIWE messages as the domain/uri).
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Database (PostgreSQL + TimescaleDB) ----
# The docker-compose service uses these; Prisma reads DATABASE_URL.
POSTGRES_USER=market
POSTGRES_PASSWORD=market_password_change_me
POSTGRES_DB=prediction_market
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://market:market_password_change_me@localhost:5432/prediction_market?schema=public

# ---- Redis (cache + pub/sub + rate-limit + websocket adapter) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth (wallet / SIWE) ----
# Chain the login signature is bound to (SIWE chainId). Monad testnet = 10143.
AUTH_CHAIN_ID=10143
# SIWE statement shown to the user in their wallet when they sign in.
AUTH_SIWE_STATEMENT=Sign in to Synthatic Prediction Market. This request will not trigger a blockchain transaction or cost any gas.
# JWT signing. Use long random strings in production (openssl rand -hex 48).
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long
# Access token lifetime (short). Refresh token lifetime (long — "just connect, no re-sign").
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
# How long a login nonce stays valid before it must be re-requested.
AUTH_NONCE_TTL_SECONDS=300

# ---- Chain / Indexer (Monad) ----
# HTTP RPC used for backfill + view calls. WS RPC (optional) enables live event streaming.
CHAIN_ID=10143
RPC_HTTP_URL=https://testnet-rpc.monad.xyz
RPC_WS_URL=
# Set to false to run the API without the on-chain indexer (e.g. local dev with seed data).
INDEXER_ENABLED=true
# Block to start indexing from (usually the deploy block of the engines).
INDEXER_START_BLOCK=0
# How many blocks to request per getLogs page during backfill.
# Monad's public RPC rejects eth_getLogs over a 100-block range
# ("eth_getLogs is limited to a 100 range"), so this must stay <= 100 there.
INDEXER_BATCH_BLOCKS=100
# Confirmations to wait before treating a block as final (reorg safety).
INDEXER_CONFIRMATIONS=2
# Poll interval (ms) when no WS is configured.
INDEXER_POLL_INTERVAL_MS=1000

# ---- Deployed contract addresses (from contracts/script/Deploy.s.sol broadcast) ----
LMSR_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
PARIMUTUEL_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
MARKET_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
TRUSTED_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000
USDC_ADDRESS=0x0000000000000000000000000000000000000000
# Collateral decimals (USDC = 6). Used to format amounts for the API/UI.
COLLATERAL_DECIMALS=6

# ---- Rate limiting (per IP, sliding window) ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---- Admin ----
# Admin authorization comes from ON-CHAIN AccessControl roles.
# This allowlist is a LOCAL-DEV fallback used only when no RPC is configured;
# the app refuses to boot in production if it is non-empty.
ADMIN_DEV_ADDRESSES=

# --- Unlink (privacy layer) ---
# Off by default so the stack boots without vendor credentials. Enabling it
# requires BOTH UNLINK_API_KEY and UNLINK_APP_ID — boot fails otherwise, because
# a half-configured privacy layer offers private trading and then cannot deliver.
UNLINK_ENABLED=false
# Hosted deployment name. Must match the frontend's NEXT_PUBLIC_UNLINK_ENVIRONMENT.
UNLINK_ENVIRONMENT=monad-testnet
# Escape hatch for a custom/local Engine. Set this OR UNLINK_ENVIRONMENT, never both.
UNLINK_ENGINE_URL=
# SERVER-ONLY. Project-scoped admin authority — never expose to the browser.
# Self-serve: https://dashboard.unlink.xyz/sign-in -> organization -> project
# (target Monad Testnet) -> API Keys -> Create key. Revealed once; copy it then.
# Monad TESTNET is open and public — no access request. Mainnet is gated:
# https://cal.com/team/unlink/chat-with-unlink
UNLINK_API_KEY=
# A namespace string YOU choose — Unlink does not issue it. Must be byte-identical
# to the frontend's NEXT_PUBLIC_UNLINK_APP_ID: it is bound into identity derivation,
# so a mismatch derives two different Unlink addresses for the same user.
UNLINK_APP_ID=numera
# Authorization-token lifetime handed to browsers (1-900s; backend max is 900).
UNLINK_TOKEN_TTL_SECONDS=900

# --- Gas relay (ERC-2771) ------------------------------------------------------------------
# Lets a trader's market account trade while holding zero native gas, which is what keeps it
# unlinkable to them: a gas transfer from their own wallet would publish the association
# permanently. The endpoint is UNAUTHENTICATED on purpose — a session would put the same link in
# our logs — so the defences are the forwarder's frozen target and the engine's minimum trade
# size, not an identity check. See src/relay/relay.service.ts.
RELAY_ENABLED=false
NUMERA_FORWARDER_ADDRESS=
# Hot key: keep a small float, top it up, alert on the spend rate rather than the balance.
RELAYER_PRIVATE_KEY=
# Monad bills the gas LIMIT, not the gas used, so this is a direct spend cap.
RELAY_MAX_GAS=700000
RELAY_MAX_FEE_GWEI=250
RELAY_ACCOUNT_LIMIT=20
RELAY_ACCOUNT_WINDOW_SECONDS=60
RELAY_DAILY_CAP_MON=20
RELAY_MIN_BALANCE_MON=2

# Automatic settlement.
#
# A proposal that survives its challenge window is not settled until somebody sends `finalize`, and
# until that lands the engine still calls the market open and every winner's claim reverts. This
# keeper sends it, from the relayer's key and through the relayer's spend limits. The call is
# permissionless and pays the recorded proposer whoever sends it, so automating it takes nothing
# away from anyone and leaves the manual path open. See src/relay/settlement.service.ts.
SETTLEMENT_ENABLED=true
SETTLEMENT_POLL_INTERVAL_MS=20000
